{
  "name": "@bizmyth/pi-neovim-editor",
  "version": "0.1.1",
  "description": "Embedded Neovim as the Pi coding agent prompt editor",
  "type": "module",
  "license": "MIT",
  "author": "Drew Council",
  "packageManager": "bun@1.3.13",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome ci . && tsc -p tsconfig.json && bun test",
    "check:fix": "biome check --write --unsafe . && tsc -p tsconfig.json && bun test",
    "test": "bun test",
    "prepublishOnly": "bun run check && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-council/pi-neovim-editor.git"
  },
  "bugs": {
    "url": "https://github.com/drew-council/pi-neovim-editor/issues"
  },
  "homepage": "https://github.com/drew-council/pi-neovim-editor#readme",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  }
}
